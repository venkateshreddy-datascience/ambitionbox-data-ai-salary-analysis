   "source": [
    "# the scraping loop\n",
    "for r in roles:\n",
    "    role_ok = True\n",
    "    for city in cities:\n",
    "        city_name = city if city else \"all-india\"\n",
    "        prev_names = None\n",
    "        for p_no in range(1, max_pages + 1):\n",
    "            url = f\"https://www.ambitionbox.com/profile/{r}-salary\"\n",
    "            if city:\n",
    "                url = url + f\"/{city}-location\"\n",
    "            if p_no > 1:\n",
    "                url = url + f\"?page={p_no}\"\n",
    "            print(url)\n",
    "            sd = get_sd(url)\n",
    "            time.sleep(2)\n",
    "            if sd is None:\n",
    "                if city is None and p_no == 1:      \n",
    "                    failed_roles.append(r)\n",
    "                    role_ok = False\n",
    "                break\n",
    "            companies = sd.get(\"salaryCompanyWiseData\") or []\n",
    "            names = [c.get(\"shortName\") for c in companies]\n",
    "            if p_no > 1 and names == prev_names:    \n",
    "                break\n",
    "            prev_names = names\n",
    "\n",
    "            for c in companies:                      \n",
    "                role.append(r)\n",
    "                location.append(city_name)\n",
    "                page_no.append(p_no)\n",
    "                company.append(c.get(\"shortName\"))\n",
    "                company_id.append(c.get(\"companyId\"))\n",
    "                avg_ctc.append(c.get(\"avgCtc\"))\n",
    "                min_ctc.append(c.get(\"minCtc\"))\n",
    "                max_ctc.append(c.get(\"maxCtc\"))\n",
    "                typical_min.append(c.get(\"typicalMinCtc\"))\n",
    "                typical_max.append(c.get(\"typicalMaxCtc\"))\n",
    "                min_exp.append(c.get(\"minExp\"))\n",
    "                max_exp.append(c.get(\"maxExp\"))\n",
    "                data_points.append(c.get(\"totalDataPoints\"))\n",
    "                job_count.append(c.get(\"jobCount\"))\n",
    "\n",
    "            if p_no == 1:                            \n",
    "                reports = ((sd.get(\"latestSalaries\") or {}).get(\"data\") or {}).get(\"latestSalaries\") or []\n",
    "                for s in reports:\n",
    "                    rep_role.append(r)\n",
    "                    rep_company.append(s.get(\"companyName\"))\n",
    "                    rep_ctc.append(s.get(\"ctc\"))\n",
    "                    rep_exp.append(s.get(\"experience\"))\n",
    "                    rep_unit.append(s.get(\"experienceUnit\"))\n",
    "                    rep_time.append(s.get(\"timeStamp\"))\n",
    "                for s in sd.get(\"skills\") or []:\n",
    "                    sk_role.append(r)\n",
    "                    sk_location.append(city_name)\n",
    "                    sk_name.append(s.get(\"name\"))\n",
    "                    sk_jobs.append(s.get(\"jobCount\"))\n",
    "                p = sd.get(\"profileSalaryData\") or {}\n",
    "                sm_role.append(r)\n",
    "                sm_location.append(city_name)\n",
    "                sm_reports.append(p.get(\"totalDatapoints\"))\n",
    "                sm_median.append(p.get(\"medianCtc\"))\n",
    "                sm_min.append(p.get(\"minCtc\"))\n",
    "                sm_max.append(p.get(\"maxCtc\"))\n",
    "                sm_jobs.append(sd.get(\"totalJobs\"))\n",
    "        if not role_ok:\n",
    "            break\n",
    "print(\"failed roles:\", failed_roles if failed_roles else \"none\")"
   ]
  },
