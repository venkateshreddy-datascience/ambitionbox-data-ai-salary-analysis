    "rep[\"year\"] = rep[\"experience_years\"].round()\n",
    "by_year = rep.groupby(\"year\")[\"ctc_lpa\"].agg([\"median\", \"count\"])\n",
    "by_year = by_year[by_year[\"count\"] >= 15]                          # only years with 15+ reports\n",
    "print(by_year.round(1))\n",
    "print(\"correlation (experience vs salary):\", round(rep[\"experience_years\"].corr(rep[\"ctc_lpa\"]), 2))\n",
    "\n",
    "plt.figure(figsize=(10, 5.5))\n",
    "plt.scatter(rep[\"experience_years\"], rep[\"ctc_lpa\"], alpha=0.3)\n",
    "plt.plot(by_year.index, by_year[\"median\"], color=\"red\", marker=\"o\", label=\"Median for each year\")\n",
    "plt.title(\"Salary vs experience (one dot = one person's report)\")\n",
    "plt.xlabel(\"Experience (years)\")\n",
    "plt.ylabel(\"Salary (LPA)\")\n",
    "plt.legend()\n",
    "plt.show()"
