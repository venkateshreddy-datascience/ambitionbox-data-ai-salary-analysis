    "city_df = df[(df[\"location\"] != \"All India\") & (df[\"data_points\"] >= 5)].copy()\n",
    "print(\"rows used for the charts:\", city_df.shape[0])\n",
    "print(\"columns used for the charts:\", city_df.shape[1])"
