   "source": [
    "# Chart 5: top paying companies\n",
    "# A normal average treats a company with 5 reports like one with 500.\n",
    "# So we use a weighted average = sum(salary x reports) / sum(reports)\n",
    "city_df[\"salary_x_reports\"] = city_df[\"avg_ctc_lpa\"] * city_df[\"data_points\"]\n",
    "comp = city_df.groupby(\"company\")[[\"salary_x_reports\", \"data_points\"]].sum()\n",
    "comp[\"weighted_salary_lpa\"] = comp[\"salary_x_reports\"] / comp[\"data_points\"]\n",
    "top10 = comp[comp[\"data_points\"] >= 50].sort_values(\"weighted_salary_lpa\", ascending=False).head(10)\n",
    "print(top10[[\"weighted_salary_lpa\", \"data_points\"]].round(1))\n",
    "\n",
    "plt.figure(figsize=(10, 5.5))\n",
    "sns.barplot(x=top10[\"weighted_salary_lpa\"], y=top10.index, color=\"steelblue\")\n",
    "plt.title(\"Top 10 paying companies (at least 50 salary reports)\")\n",
    "plt.xlabel(\"Weighted salary (LPA)\")\n",
    "plt.ylabel(\"\")\n",
    "plt.show()"
   ]
