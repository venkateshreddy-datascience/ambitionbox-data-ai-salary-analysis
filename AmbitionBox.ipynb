picalMaxCtc\":5064897.447009162,\"minExp\":0,\"maxExp\":5,\"jobCount\":0,\"alertCreated\":false,\"includeLocUrl\":false},{\"companyId\":168749,\"logo\":\"coursera\",\"shortName\":\"Coursera\",\"urlName\":\"coursera\",\"jobProfileUrlName\":\"data-scientist\",\"totalDataPoints\":59,\"minCtc\":3760000,\"maxCtc\":4660000,\"avgCtc\":4274012.269535184,\"typicalMinCtc\":4060311.6560584246,\"typicalMaxCtc\":4487712.883011944,\"minExp\":1,\"maxExp\":7,\"jobCount\":0,\"alertCreated\":false,\"includeLocUrl\":false}],\"pagination\":{\"count\":14180,\"currentPage\":1,\"totalPages\":20}},\"desigInterview\":{\"pagination\":{\"currentPage\":1,\"totalPages\":50,\"totalQuestions\":1240},\"questions\":[{\"question\":\"You have a pandas dataframe with three columns filled with state names, city names, and arbitrary numbers, respectively. How do you retrieve the top two cities per state based on the maximum number in the third column?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"coding_gen_ai\",\"questionUrl\":\"you-have-a-pandas-dataframe-with-three-columns-filled-with-state-names-city-names-and-arbitrary-numbers-respectively-how-do-you-retrieve-the-top-two-cities-per-state-based-on-bjHiHjpfI\",\"companyUrl\":\"affine-analytics\",\"companyName\":\"Affine\",\"answersCount\":3,\"skills\":[],\"topCompanies\":[{\"logo\":\"affine-analytics-512\",\"id\":\"512\",\"urlName\":\"affine-analytics\",\"name\":\"Affine\"}],\"companiesCount\":0,\"updatedOn\":\"3d ago\",\"answerByGenAI\":{\"summary\":\"Retrieve the top two cities per state based on the maximum number in the third column of a pandas dataframe.\",\"approach\":[\"Group the dataframe by the \\'state\\' column.\",\"Within each group, sort the rows by the numeric column in descending order.\",\"Select the top two rows (cities) from each group.\",\"Combine the results to get the final dataframe.\"],\"timeComplexity\":\"O(n log n) due to sorting within groups where n is the number of rows\",\"spaceComplexity\":\"O(n) to store the grouped and filtered dataframe\",\"code\":{\"python\":\"import pandas as pd\\\\n\\\\ndef top_two_cities_per_state(df):\\\\n    return df.sort_values([\\'state\\', df.columns[2]], ascending=[True, False]).groupby(\\'state\\').head(2)\"}}},{\"question\":\"Describe the data you would analyze to solve cost and revenue optimization case studies. How would you formulate the objective functions?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"describe-the-data-you-would-analyze-to-solve-cost-and-revenue-optimization-case-studies-how-would-you-formulate-the-objective-functions-bjduUXTRA\",\"companyUrl\":\"walmart\",\"companyName\":\"Walmart\",\"answersCount\":3,\"skills\":[],\"topCompanies\":[{\"logo\":\"walmart\",\"id\":\"13122\",\"urlName\":\"walmart\",\"name\":\"Walmart\"}],\"companiesCount\":0,\"updatedOn\":\"3d ago\",\"answerByGenAI\":\"\\\\\"- **Data Inputs:** Sales transactions (SKU, price, units, timestamp, location), cost data (COGS, variable vs fixed, shipping, handling), inventory \\\\u0026 supply chain (lead times, stock levels, supplier costs), promotions/marketing spend, customer signals (segments, elasticity, churn), operational metrics (labor, store hours), and external data (seasonality, competitor prices, macro indicators).\\\\\\\\n\\\\\\\\n- **Granularity \\\\u0026 Hygiene:** Use **SKU-store-day** or **SKU-region-week** aggregates; clean for returns, promotions, stockouts, and censoring. Impute or mark missing demand during stockouts to avoid bias.\\\\\\\\n\\\\\\\\n- **Key derived features / metrics:** Contribution margin per SKU = price - variable_cost; price elasticity estimates; lifetime value (LTV); fill rate, stockout probability; unit economics and channel-level CAC.\\\\\\\\n\\\\\\\\n- **Modeling approach:** Build demand models (time-series + features, hierarchical Bayesian or causal uplift for promotions), cost drivers models (regression or activity-based costing), and optimization layer (linear/nonlinear programming or stochastic optimization) that consumes predicted demand and costs.\\\\\\\\n\\\\\\\\n- **Objective function formulation:**  \\\\\\\\n  - **Single-objective (profit):** Maximize Profit = Sum_over_SKUs (price_i * demand_i(price_i) - total_cost_i)  \\\\\\\\n  - **Cost minimization:** Minimize Total_Cost = Fixed_Costs + Sum(variable_cost_i * volume_i)  \\\\\\\\n  - **Multi-objective:** Maximize (w1 * Profit_norm + w2 * Revenue_norm - w3 * Risk_penalty) where weights reflect business priorities.  \\\\\\\\n  Include constraints as plain text: inventory balance, service-level \\\\u003e= X%, price bounds, promo budgets, supplier capacity.\\\\\\\\n\\\\\\\\n- **Validation \\\\u0026 deployment:** Validate via A/B tests or quasi-experiments, simulate scenarios (what-if), monitor KPIs (profit uplift, margin, revenue, service levels), and add regularization/robustness to handle demand uncertainty and prevent overfitting.\\\\\"\"},{\"question\":\"Given a list of numbers, find the indices of two numbers that add up to a specific target value. Do this without using nested for loops. For example, given the list l = [2, 15, 5, 7] and target t = 9, the output should be [0, 3].\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"coding_gen_ai\",\"questionUrl\":\"given-a-list-of-numbers-find-the-indices-of-two-numbers-that-add-up-to-a-specific-target-value-do-this-without-using-nested-for-loops-for-example-given-the-list-l-2-15-5-7-bksjpwSZO\",\"companyUrl\":\"coforge\",\"companyName\":\"Coforge\",\"answersCount\":1,\"skills\":[],\"topCompanies\":[{\"logo\":\"coforge-d-2\",\"id\":\"764623\",\"urlName\":\"coforge\",\"name\":\"Coforge\"}],\"companiesCount\":0,\"updatedOn\":\"1d ago\",\"answerByGenAI\":{\"summary\":\"Find indices of two numbers in a list that add up to a target without nested loops\",\"approach\":[\"Initialize an empty hash map (dictionary) to store number to index mappings\",\"Iterate through the list, for each number compute the complement as target minus the current number\",\"Check if the complement exists in the hash map; if yes, return the pair of indices\",\"If not, store the current number and its index in the hash map\",\"If no pair is found by the end, return an empty list or indication of no solution\"],\"timeComplexity\":\"O(n) where n is the number of elements in the list\",\"spaceComplexity\":\"O(n) due to storing elements in the hash map\",\"code\":{\"python\":\"def two_sum(nums, target):\\\\n    lookup = {}\\\\n    for i, num in enumerate(nums):\\\\n        complement = target - num\\\\n        if complement in lookup:\\\\n            return [lookup[complement], i]\\\\n        lookup[num] = i\\\\n    return []\",\"java\":\"import java.util.HashMap;\\\\nimport java.util.Map;\\\\npublic class Solution {\\\\n    public int[] twoSum(int[] nums, int target) {\\\\n        Map\\\\u003cInteger, Integer\\\\u003e map = new HashMap\\\\u003c\\\\u003e();\\\\n        for (int i = 0; i \\\\u003c nums.length; i++) {\\\\n            int complement = target - nums[i];\\\\n            if (map.containsKey(complement)) {\\\\n                return new int[] { map.get(complement), i };\\\\n            }\\\\n            map.put(nums[i], i);\\\\n        }\\\\n        return new int[0];\\\\n    }\\\\n}\",\"cpp\":\"#include \\\\u003cunordered_map\\\\u003e\\\\n#include \\\\u003cvector\\\\u003e\\\\nusing namespace std;\\\\n\\\\nvector\\\\u003cint\\\\u003e twoSum(vector\\\\u003cint\\\\u003e\\\\u0026 nums, int target) {\\\\n    unordered_map\\\\u003cint, int\\\\u003e map;\\\\n    for (int i = 0; i \\\\u003c nums.size(); i++) {\\\\n        int complement = target - nums[i];\\\\n        if (map.find(complement) != map.end()) {\\\\n            return {map[complement], i};\\\\n        }\\\\n        map[nums[i]] = i;\\\\n    }\\\\n    return {};\\\\n}\",\"javascript\":\"function twoSum(nums, target) {\\\\n    const map = new Map();\\\\n    for (let i = 0; i \\\\u003c nums.length; i++) {\\\\n        const complement = target - nums[i];\\\\n        if (map.has(complement)) {\\\\n            return [map.get(complement), i];\\\\n        }\\\\n        map.set(nums[i], i);\\\\n    }\\\\n    return [];\\\\n}\"}}},{\"question\":\"How would you measure model effectiveness without using any confusion matrix metrics, given the data is highly imbalanced?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"how-would-you-measure-model-effectiveness-without-using-any-confusion-matrix-metrics-given-the-data-is-highly-imbalanced-bjS0KIC6u\",\"companyUrl\":\"exl-service\",\"companyName\":\"EXL Service\",\"answersCount\":2,\"skills\":[],\"topCompanies\":[{\"logo\":\"exl-service-d\",\"id\":\"146\",\"urlName\":\"exl-service\",\"name\":\"EXL Service\"}],\"companiesCount\":0,\"updatedOn\":\"3d ago\",\"answerByGenAI\":\"\\\\\"- **Objective:** Focus on **probability-quality** and **business-impact** metrics rather than label-based confusion metrics when data is highly imbalanced.\\\\\\\\n\\\\\\\\n- **Log loss / Negative log-likelihood:** Measures the quality of predicted probabilities; penalizes confident wrong predictions and is robust for imbalanced classes.\\\\\\\\n\\\\\\\\n- **Brier score and calibration:** Use **Brier score** and **reliability diagrams / ECE (expected calibration error)** to ensure predicted probabilities reflect true event rates — crucial when decisions use scores as risks.\\\\\\\\n\\\\\\\\n- **Ranking / Lift-oriented metrics:** Evaluate **lift, cumulative gains, and NDCG** at business-relevant cutoffs (e.g., top 1–5%). These assess how well the model prioritizes rare positives without relying on a full confusion matrix.\\\\\\\\n\\\\\\\\n- **Business value / expected utility:** Compute **expected value / profit**, cost-sensitive expected loss, or decision-analytic metrics (simulate interventions and measure ROI, cost per true positive captured) to align model effectiveness with business outcomes.\\\\\\\\n\\\\\\\\n- **Robustness checks:** Monitor **stability over time (drift), calibration across segments**, and perform uplift or permutation-based feature importance to validate consistent behavior on minority segments.\\\\\"\"},{\"question\":\"You have two different vectors with only a small change in one of the dimensions, but the predictions/output from the model are drastically different for each vector. Can you explain why this can be the case? Is that a good thing or a bad thing? If bad, what can be done to fix it?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"you-have-two-different-vectors-with-only-a-small-change-in-one-of-the-dimensions-but-the-predictions-or-output-from-the-model-are-drastically-different-for-each-vector-can-bjEH4FlxM\",\"companyUrl\":\"geekbull-consulting\",\"companyName\":\"GeekBull Consulting\",\"answersCount\":1,\"skills\":[],\"topCompanies\":[{\"id\":\"860825\",\"urlName\":\"geekbull-consulting\",\"name\":\"GeekBull Consulting\"}],\"companiesCount\":0,\"updatedOn\":\"2d ago\",\"answerByGenAI\":\"\\\\\"- **Cause — model sensitivity:** Small change can cross a **decision boundary** in a non-linear model (deep nets, tree ensembles), so outputs change sharply; models can also be sensitive to unnormalized features or spurious correlations learned from training data.  \\\\\\\\n- **Is it good or bad:** Generally **bad** for reliability and user trust if small, irrelevant changes produce large output swings; but expected in tasks with inherent thresholds (e.g., classification near a true boundary).  \\\\\\\\n- **Data issues:** Imbalanced classes, label noise, or insufficient coverage near that region can amplify sensitivity.  \\\\\\\\n- **Fixes — training/data:** Increase representative data around the boundary, use data augmentation, clean labels, and add adversarial examples to improve local robustness.  \\\\\\\\n- **Fixes — modeling/regularization:** Apply regularization (L2, dropout), gradient clipping, ensembling, input **normalization/standardization**, and consider smoother activation/loss functions or monotonic constraints if appropriate.  \\\\\\\\n- **Debugging:** Visualize decision boundary or gradients, run sensitivity/adversarial tests, and use calibration/uncertainty estimates to detect unreliable predictions.\\\\\"\"},{\"question\":\"In which direction does fluid flow in a vertical pipe when the pressures at two vertical locations are given?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"in-which-direction-does-fluid-flow-in-a-vertical-pipe-when-the-pressures-at-two-vertical-locations-are-given-bjBo1bLEi\",\"companyUrl\":\"exxon-mobil\",\"companyName\":\"ExxonMobil\",\"answersCount\":1,\"skills\":[],\"topCompanies\":[{\"logo\":\"exxon-mobil\",\"id\":\"239\",\"urlName\":\"exxon-mobil\",\"name\":\"ExxonMobil\"}],\"companiesCount\":0,\"updatedOn\":\"4d ago\",\"answerByGenAI\":\"\\\\\"If the pressures are given at two vertical locations, fluid flows from the location with **higher total head** to the location with **lower total head**. For incompressible flow (neglecting losses) use the hydraulic head:  \\\\\\\\nhead = p/(ρ g) + z.  \\\\\\\\n\\\\\\\\nSo compare h1 = p1/(ρ g) + z1 and h2 = p2/(ρ g) + z2. If h_lower \\\\u003e h_upper the net flow is **upward** (from lower to upper); if h_upper \\\\u003e h_lower the flow is **downward**. In words: fluid moves toward the point of lower pressure plus elevation potential, accounting for gravity.\\\\\"\"},{\"question\":\"How can you tune the hyperparameters of XGBoost, Random Forest, and SVM algorithms?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"how-can-you-tune-the-hyperparameters-of-xgboost-random-forest-and-svm-algorithms-bjduDNXqq\",\"companyUrl\":\"walmart\",\"companyName\":\"Walmart\",\"answersCount\":2,\"skills\":[],\"topCompanies\":[{\"logo\":\"walmart\",\"id\":\"13122\",\"urlName\":\"walmart\",\"name\":\"Walmart\"}],\"companiesCount\":0,\"updatedOn\":\"1d ago\",\"answerByGenAI\":\"\\\\\"- **XGBoost:** Tune tree parameters first — **max_depth**, **min_child_weight**, **gamma**, **subsample**, **colsample_bytree**. Use **learning_rate (eta)** with more trees (lower eta, higher n_estimators). Start with grid/random search or Bayesian (Optuna) over sensible ranges, then fine‑tune using early stopping on a validation set to avoid overfitting.\\\\\\\\n\\\\\\\\n- **Random Forest:** Focus on **n_estimators**, **max_features**, **max_depth**, **min_samples_split/min_samples_leaf**, and class weighting for imbalance. Use randomized search to find good **max_features** and tree depth, then increase **n_estimators** until OOB (out‑of‑bag) or validation metrics stabilize. Prefer simpler trees (shallower) if variance is high.\\\\\\\\n\\\\\\\\n- **SVM:** Choose kernel first (linear, RBF, polynomial). For **linear**, tune **C**; for **RBF**, tune **C** and **gamma** (use log scale). Scale features (StandardScaler), use stratified CV, and run grid or Bayesian search; consider LinearSVC or approximate methods for large datasets.\\\\\\\\n\\\\\\\\n- **Workflow:** Use **nested cross‑validation** or hold‑out validation with stratification, optimize by objective metric (AUC, F1) depending on business need, and monitor calibration/confusion tradeoffs. Regularize, check learning curves, and prefer Bayesian/Hyperband for efficiency.\\\\\\\\n\\\\\\\\n- **Tools \\\\u0026 checks:** Use **scikit-learn**, **XGBoost/LightGBM**, and hyperparameter libraries (Optuna, Hyperopt). Validate on unseen test set, inspect feature importance/SHAP, and ensure model latency and memory meet production constraints.\\\\\"\"},{\"question\":\"When tokenizing, if you want to avoid breaking up specific word pairs (or triplets), for example, to not tokenize the words \\'first\\' and \\'name\\' when they occur together and consider them as a single token, how would you approach this?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"coding_gen_ai\",\"questionUrl\":\"when-tokenizing-if-you-want-to-avoid-breaking-up-specific-word-pairs-or-triplets-for-example-to-not-tokenize-the-words-first-and-name-when-they-occur-together-and-consider-bjEHgjqoK\",\"companyUrl\":\"intellect-design-arena\",\"companyName\":\"Intellect Design Arena\",\"answersCount\":1,\"skills\":[],\"topCompanies\":[{\"logo\":\"intellect-design-arena-153171\",\"id\":\"153171\",\"urlName\":\"intellect-design-arena\",\"name\":\"Intellect Design Arena\"}],\"companiesCount\":0,\"updatedOn\":\"2d ago\",\"answerByGenAI\":{\"summary\":\"Approach to tokenizing text while preserving specific multi-word phrases as single tokens.\",\"approach\":[\"Identify the specific word pairs or triplets that should be treated as single tokens.\",\"Preprocess the input text by replacing occurrences of these phrases with a placeholder token (e.g., \\'first_name\\').\",\"Perform tokenization on the modified text normally without splitting the placeholders.\",\"Optionally, post-process tokens to revert placeholders back to the original phrase if needed.\"],\"code\":{}}},{\"question\":\"How do you retain special characters (that pandas discards by default) in the data while reading it?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"coding_gen_ai\",\"questionUrl\":\"how-do-you-retain-special-characters-that-pandas-discards-by-default-in-the-data-while-reading-it-bjHi9Nq8a\",\"companyUrl\":\"affine-analytics\",\"companyName\":\"Affine\",\"answersCount\":1,\"skills\":[],\"topCompanies\":[{\"logo\":\"affine-analytics-512\",\"id\":\"512\",\"urlName\":\"affine-analytics\",\"name\":\"Affine\"}],\"companiesCount\":0,\"updatedOn\":\"1d ago\",\"answerByGenAI\":{\"summary\":\"How to retain special characters in data while reading with pandas\",\"approach\":[\"Use the encoding parameter in pandas read_csv or read_table to specify an encoding that supports special characters, such as \\'utf-8\\' or \\'latin1\\'.\",\"Set keep_default_na=False to prevent pandas from interpreting certain special characters as NaN values.\",\"Use quoting=csv.QUOTE_NONE and escapechar if special characters include delimiters or quotes.\",\"If reading from CSV or similar, ensure the file is saved with the correct encoding and that pandas read function matches that encoding.\"],\"code\":{}}},{\"question\":\"What are the different types of machine learning algorithms and the ML technique used for each algorithm?\",\"containsHtml\":false,\"answer\":null,\"answerType\":\"non_coding_gen_ai\",\"questionUrl\":\"what-are-the-different-types-of-machine-learning-algorithms-and-the-ml-technique-used-for-each-algorithm-bu8cQ4aXS\",\"companyUrl\":\"rolls-royce\",\"companyName\":\"Rolls-Royce\",\"answersCount\":2,\"skills\":[],\"topCompanies\":[{\"logo\":\"labmentix\",\"id\":\"2003680\",\"urlName\":\"labmentix\",\"name\":\"Labmentix\"}],\"companiesCount\":1,\"updatedOn\":\"6d ago\",\"answerByGenAI\":\"\\\\\"- **Supervised Learning:** **Classification** (Logistic Regression, SVM, Decision Trees, Random Forests, Gradient Boosting) and **Regression** (Linear Regression, Ridge/Lasso, SVR, GBM) — used when labeled data maps inputs to outputs.  \\\\\\\\n- **Unsupervised Learning:** **Clustering** (K‑means, Hierarchical, DBSCAN) and **Dimensionality Reduction** (PCA, t‑SNE, UMAP) — for structure discovery and feature compression without labels.  \\\\\\\\n- **Semi‑supervised Learning:** **Label Propagation / Self‑training / Consistency Regularization** — combines small labeled set with large unlabeled data to improve generalization.  \\\\\\\\n- **Reinforcement Learning:** **Value‑based** (Q‑learning, DQN) and **Policy‑based** (REINFORCE, PPO, Actor‑Critic) — learning policies via rewards in sequential decision problems.  \\\\\\\\n- **Deep Learning (subset across above):** **CNNs** for images, **RNNs/Transformers** for sequences/text — end‑to‑end feature learning with large data.  \\\\\\\\n- **Probabilistic Models \\\\u0026 Time‑series:** **Bayesian Networks / HMMs / Kalman Filters** — handle uncertainty and temporal dependencies.  \\\\\\\\n- **Anomaly Detection / One‑class Problems:** **One‑Class SVM, Isolation Forest, Autoencoders** — detect outliers or rare events.\\\\\"\"}]},\"noIndex\":false,\"occupationalJSONLD\":{\"@context\":\"http://schema.googleapis.com/\",\"@type\":\"Occupation\",\"name\":\"Data Scientist salaries in India by 61000+ Employees (Updated 2026)\",\"experienceRequirements\":\"1-8\",\"url\":\"https://www.ambitionbox.com/profile/data-scientist-salary\",\"occupationLocation\":{\"@type\":\"Country\",\"name\":\"India\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"lastReviewed\":\"2026-10-12T02:26:21Z\"},\"estimatedSalary\":[{\"@type\":\"MonetaryAmountDistribution\",\"name\":\"base\",\"currency\":\"INR\",\"duration\":\"P1Y\",\"median\":1608678.0885113596,\"percentile10\":562864.1,\"percentile25\":766133.2,\"percentile75\":1770065.2,\"percentile90\":2518436.4}],\"skills\":[\"Python\",\"SQL\",\"Analytics\",\"Data Analysis\",\"Artificial Intelligence\"],\"occupationalCategory\":[\"IT Services \\\\u0026 Consulting\",\"Internet\",\"Financial Services\"],\"description\":\"Data Scientist salary in India ranges between ₹ 15.3 Lakhs to ₹ 16.9 Lakhs with an average annual salary of ₹ 16.1 Lakhs. Salary estimates are based on 61.6k salaries received from Data Scientists.\"}},\"tabsData\":[{\"name\":\"Salaries\",\"title\":\"Data Scientist Salaries\",\"path\":\"/profile/data-scientist-salary\",\"count\":61578},{\"name\":\"Interviews\",\"title\":\"Data Scientist Interviews\",\"path\":\"/profiles/data-scientist/interview-questions\",\"count\":1518},{\"name\":\"Jobs\",\"title\":\"Data Scientist Jobs\",\"path\":\"/jobs/data-scientist-jobs-prf\",\"count\":1321}],\"appliedFiltersData\":{\"department\":null,\"industry\":null,\"location\":null,\"tag\":null},\"desigProfileData\":{\"id\":11,\"shortName\":\"Data Scientist\",\"urlName\":\"data-scientist\",\"companyReviewsLive\":9031,\"interviewExperiencesLive\":1518,\"rating\":3.63,\"companyS