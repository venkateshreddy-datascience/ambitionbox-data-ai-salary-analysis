    "# lists to tables, then save\n",
    "df = pd.DataFrame({\"role\": role, \"location\": location, \"page\": page_no, \"company\": company,\n",
    "                   \"company_id\": company_id, \"avg_ctc\": avg_ctc, \"min_ctc\": min_ctc, \"max_ctc\": max_ctc,\n",
    "                   \"typical_min_ctc\": typical_min, \"typical_max_ctc\": typical_max, \"min_exp\": min_exp,\n",
    "                   \"max_exp\": max_exp, \"data_points\": data_points, \"job_count\": job_count})\n",
    "reports_df = pd.DataFrame({\"role\": rep_role, \"company\": rep_company, \"ctc\": rep_ctc,\n",
    "                           \"experience\": rep_exp, \"experience_unit\": rep_unit, \"timestamp\": rep_time})\n",
    "skills_df = pd.DataFrame({\"role\": sk_role, \"location\": sk_location, \"skill\": sk_name, \"job_count\": sk_jobs})\n",
    "summary_df = pd.DataFrame({\"role\": sm_role, \"location\": sm_location, \"total_reports\": sm_reports,\n",
    "                           \"median_ctc\": sm_median, \"min_ctc\": sm_min, \"max_ctc\": sm_max, \"total_jobs\": sm_jobs})\n",
    "df.to_csv(\"raw_company_salaries.csv\", index=False)\n",
    "reports_df.to_csv(\"raw_latest_salaries.csv\", index=False)\n",
    "skills_df.to_csv(\"raw_role_skills.csv\", index=False)\n",
    "summary_df.to_csv(\"raw_role_summary.csv\", index=False)\n",
    "print(df.shape, reports_df.shape, skills_df.shape, summary_df.shape)\n",
    "df.head()"
   ]
