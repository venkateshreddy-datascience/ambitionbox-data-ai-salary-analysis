   "source": [
    "# DATA CLEANING\n",
    "df = pd.read_csv(\"raw_company_salaries.csv\")\n",
    "print(df.shape)\n",
    "df.info()\n",
    "print(df.isnull().sum())\n",
    "print(\"duplicate rows:\", df.duplicated(subset=[\"role\", \"location\", \"company\"]).sum())\n",
    "df.describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "2544ff09-91da-4a6a-ac64-c53c59354c19",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "duplicates removed: 2\n",
      "rows without salary removed: 0\n",
      "junior-data-scientist rows removed: 173\n",
      "min_exp    0\n",
      "max_exp    0\n",
      "dtype: int64\n",
      "flagged min/avg/max rows: 29 | outliers: 77\n",
      "(2158, 15)\n"
     ]
    }
   ],
   "source": [
    "# Clean the main table\n",
    "\n",
    "# 1. remove duplicate rows\n",
    "before = len(df)\n",
    "df = df.drop_duplicates(subset=[\"role\", \"location\", \"company\"])\n",
    "print(\"duplicates removed:\", before - len(df))\n",
    "\n",
    "# 2. remove rows with no salary\n",
    "before = len(df)\n",
    "df = df.dropna(subset=[\"avg_ctc\"])\n",
    "print(\"rows without salary removed:\", before - len(df))\n",
    "\n",
    "# 3. drop the role that has almost no data\n",
    "before = len(df)\n",
    "df = df[df[\"role\"] != \"junior-data-scientist\"]\n",
    "print(\"junior-data-scientist rows removed:\", before - len(df))\n",
    "\n",
    "# 4. clean the text with regex re.sub (Regex lecture): 'new-delhi' -> 'New Delhi'\n",
    "df[\"role\"] = df[\"role\"].apply(lambda x: re.sub(r\"-\", \" \", x).title())\n",
    "df[\"location\"] = df[\"location\"].apply(lambda x: re.sub(r\"-\", \" \", x).title())\n",
    "df[\"role\"] = df[\"role\"].replace({\"Ai Engineer\": \"AI Engineer\"})\n",
    "df[\"company\"] = df[\"company\"].apply(lambda x: re.sub(r\"\\s+\", \" \", str(x)).strip())\n",
    "\n",
    "# 5. rupees -> lakhs per year (LPA)\n",
    "for col in [\"avg_ctc\", \"min_ctc\", \"max_ctc\", \"typical_min_ctc\", \"typical_max_ctc\"]:\n",
    "    df[col + \"_lpa\"] = (df[col] / 100000).round(2)\n",
    "df = df.drop(columns=[\"avg_ctc\", \"min_ctc\", \"max_ctc\", \"typical_min_ctc\", \"typical_max_ctc\", \"page\"])\n",
    "\n",
    "# 6. missing experience -> fill with the median (note the brackets: median())\n",
    "print(df[[\"min_exp\", \"max_exp\"]].isnull().sum())\n",
    "df[\"min_exp\"] = df[\"min_exp\"].fillna(df[\"min_exp\"].median())\n",
    "df[\"max_exp\"] = df[\"max_exp\"].fillna(df[\"max_exp\"].median())\n",
    "\n",
    "# 7. correct data types\n",
    "df[\"data_points\"] = df[\"data_points\"].fillna(0).astype(int)\n",
    "df[\"job_count\"] = df[\"job_count\"].fillna(0).astype(int)\n",
    "\n",
    "# 8. flag (do not delete) strange rows\n",
    "df[\"salary_check_flag\"] = (df[\"min_ctc_lpa\"] > df[\"avg_ctc_lpa\"]) | (df[\"avg_ctc_lpa\"] > df[\"max_ctc_lpa\"])\n",
    "q1 = df[\"avg_ctc_lpa\"].quantile(0.25)\n",
    "q3 = df[\"avg_ctc_lpa\"].quantile(0.75)\n",
    "iqr = q3 - q1\n",
    "df[\"salary_outlier\"] = (df[\"avg_ctc_lpa\"] < q1 - 1.5 * iqr) | (df[\"avg_ctc_lpa\"] > q3 + 1.5 * iqr)\n",
    "print(\"flagged min/avg/max rows:\", df[\"salary_check_flag\"].sum(), \"| outliers:\", df[\"salary_outlier\"].sum())\n",
    "print(df.shape)"
   ]
  },
