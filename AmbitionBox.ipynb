   "source": [
    "# Cell 13 - new columns + saving the clean files\n",
    "# new columns made from the existing ones\n",
    "df[\"avg_exp\"] = (df[\"min_exp\"] + df[\"max_exp\"]) / 2\n",
    "df[\"exp_group\"] = pd.cut(df[\"avg_exp\"], bins=[-1, 2, 5, 100],\n",
    "                         labels=[\"Fresher (0-2 yrs)\", \"Mid (3-5 yrs)\", \"Senior (6+ yrs)\"])\n",
    "df[\"salary_range_lpa\"] = (df[\"max_ctc_lpa\"] - df[\"min_ctc_lpa\"]).round(2)\n",
    "\n",
    "print(\"Main table:\", df.shape)\n",
    "print(df.columns.tolist())\n",
    "\n",
    "# save the cleaned data (project deliverable: cleaned dataset)\n",
    "df.to_csv(\"clean_company_salaries.csv\", index=False)\n",
    "reports.to_csv(\"clean_salary_reports.csv\", index=False)\n",
    "skills.to_csv(\"clean_role_skills.csv\", index=False)\n",
    "summary.to_csv(\"clean_role_summary.csv\", index=False)\n",
    "df.head()"
   ]
  },
