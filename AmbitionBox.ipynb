   "source": [
    "# cleaning the other three tables\n",
    "# individual salary reports\n",
    "reports = pd.read_csv(\"raw_latest_salaries.csv\")\n",
    "reports = reports[reports[\"role\"] != \"junior-data-scientist\"]\n",
    "reports = reports.dropna(subset=[\"ctc\", \"experience\"])\n",
    "reports[\"experience_years\"] = np.where(reports[\"experience_unit\"] == \"m\", reports[\"experience\"] / 12, reports[\"experience\"])\n",
    "reports[\"ctc_lpa\"] = (reports[\"ctc\"] / 100000).round(2)\n",
    "reports[\"timestamp\"] = pd.to_datetime(reports[\"timestamp\"], errors=\"coerce\")\n",
    "reports[\"role\"] = reports[\"role\"].apply(lambda x: re.sub(r\"-\", \" \", x).title()).replace({\"Ai Engineer\": \"AI Engineer\"})\n",
    "before = len(reports)\n",
    "reports = reports.drop_duplicates(subset=[\"role\", \"company\", \"ctc_lpa\", \"experience_years\", \"timestamp\"])\n",
    "print(\"repeated reports removed:\", before - len(reports))\n",
    "reports = reports.drop(columns=[\"ctc\", \"experience\", \"experience_unit\", \"location\"], errors=\"ignore\")   # location (older files only) is not needed\n",
    "reports[\"exp_group\"] = pd.cut(reports[\"experience_years\"], bins=[-1, 2, 5, 100],\n",
    "                              labels=[\"Fresher (0-2 yrs)\", \"Mid (3-5 yrs)\", \"Senior (6+ yrs)\"])\n",
    "\n",
    "# skills\n",
    "skills = pd.read_csv(\"raw_role_skills.csv\")\n",
    "skills = skills[skills[\"role\"] != \"junior-data-scientist\"]\n",
    "skills[\"skill\"] = skills[\"skill\"].apply(lambda x: re.sub(r\"\\s+\", \" \", str(x)).strip().title())\n",
    "skills[\"role\"] = skills[\"role\"].apply(lambda x: re.sub(r\"-\", \" \", x).title()).replace({\"Ai Engineer\": \"AI Engineer\"})\n",
    "skills[\"location\"] = skills[\"location\"].apply(lambda x: re.sub(r\"-\", \" \", x).title())\n",
    "skills = skills.drop_duplicates(subset=[\"role\", \"location\", \"skill\"])\n",
    "\n",
    "# role summary\n",
    "summary = pd.read_csv(\"raw_role_summary.csv\")\n",
    "summary = summary.rename(columns={\"total_datapoints\": \"total_reports\"})     # older files used this name\n",
    "summary = summary[summary[\"role\"] != \"junior-data-scientist\"]\n",
    "summary[\"median_ctc_lpa\"] = (summary[\"median_ctc\"] / 100000).round(2)\n",
    "summary = summary.drop(columns=[\"median_ctc\", \"min_ctc\", \"max_ctc\"])\n",
    "summary[\"role\"] = summary[\"role\"].apply(lambda x: re.sub(r\"-\", \" \", x).title()).replace({\"Ai Engineer\": \"AI Engineer\"})\n",
    "summary[\"location\"] = summary[\"location\"].apply(lambda x: re.sub(r\"-\", \" \", x).title())\n",
    "print(reports.shape, skills.shape, summary.shape)"
   ]
  },
